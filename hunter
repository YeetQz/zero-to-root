# ───────────────────────── look & feel ─────────────────────────
# ANSI escape codes: \033[...m changes colour/style in the terminal.
TTY = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
FAST = "--fast" in sys.argv or not TTY


def c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if TTY else text


BLUE = lambda t: c("38;5;39", t)      # noqa: E731  System blue
CYAN = lambda t: c("38;5;51", t)      # noqa: E731
DIM = lambda t: c("2", t)             # noqa: E731
BOLD = lambda t: c("1", t)            # noqa: E731
GREEN = lambda t: c("38;5;48", t)     # noqa: E731
GOLD = lambda t: c("38;5;220", t)     # noqa: E731
RED = lambda t: c("38;5;203", t)      # noqa: E731
PURPLE = lambda t: c("38;5;141", t)   # noqa: E731

RANK_COLOR = {"E": DIM, "D": GREEN, "C": CYAN, "B": BLUE, "A": PURPLE, "S": GOLD}
ANSI = re.compile(r"\033\[[0-9;]*m")
W = 60  # inner width of the status window


def sleep(s: float) -> None:
    if not FAST:
        time.sleep(s)


def type_out(text: str, delay: float = 0.012, end: str = "\n") -> None:
    """Typewriter effect: print one character at a time."""
    if FAST:
        print(text, end=end)
        return
    i = 0
    while i < len(text):
        m = ANSI.match(text, i)          # print colour codes instantly
        if m:
            sys.stdout.write(m.group(0))
            i = m.end()
            continue
        sys.stdout.write(text[i])
        sys.stdout.flush()
        time.sleep(delay)
        i += 1
    sys.stdout.write(end)


def visible_len(s: str) -> int:
    return len(ANSI.sub("", s))


def pad(text: str, width: int) -> str:
    """Pad coloured text to a visible width (colour codes take no space on screen)."""
    return text + " " * max(width - visible_len(text), 0)


def row(content: str = "") -> str:
    """One line inside the window, padded so the right border lines up."""
    pad = W - visible_len(content)
    return BLUE("║ ") + content + " " * max(pad, 0) + BLUE(" ║")


def top(title: str = "") -> str:
    if not title:
        return BLUE("╔" + "═" * (W + 2) + "╗")
    t = f" {title} "
    left = (W + 2 - len(t)) // 2
    return BLUE("╔" + "═" * left) + BOLD(CYAN(t)) + BLUE("═" * (W + 2 - left - len(t)) + "╗")


def mid() -> str:
    return BLUE("╟" + "─" * (W + 2) + "╢")


def bottom() -> str:
    return BLUE("╚" + "═" * (W + 2) + "╝")


def system_msg(text: str) -> None:
    type_out(BLUE("[SYSTEM] ") + text, 0.018)


# ───────────────────────── commands ─────────────────────────

def cmd_status() -> None:
    h = system.compute()
    rc = RANK_COLOR.get(h.rank, BOLD)

    if not FAST:
        print()
        system_msg("Synchronizing with the player...")
        sleep(0.3)
        system_msg(f"Player detected: {BOLD(h.name)}")
        sleep(0.3)
        print()

    lines = [
        top("S T A T U S"),
        row(),
        row(f"{DIM('NAME')}   {pad(BOLD(h.name), 30)}{DIM('LEVEL')}  {BOLD(GOLD(str(h.level)))}"),
        row(f"{DIM('JOB')}    {pad(h.job, 30)}{DIM('RANK')}   {rc(BOLD(h.rank + '-Rank'))}"),
        row(f"{DIM('TITLE')}  {GOLD(h.title)}"),
        row(),
        row(f"{DIM('XP')}     {CYAN(system.bar(h.xp_into_level, h.xp_per_level, 30))}  "
            f"{h.xp_into_level}/{h.xp_per_level}"),
        row(f"{DIM('       total')} {h.xp} XP  {DIM('·')}  {h.xp_per_level - h.xp_into_level} to level {h.level + 1}"),
        mid(),
    ]
    stat_items = list(h.stats.items())
    for i in range(0, len(stat_items), 2):
        cells = []
        for key, (val, name) in stat_items[i:i + 2]:
            cells.append(pad(f"{BOLD(key)}  {pad(DIM(name), 13)}{GREEN(str(val).rjust(3))}", 26))
        lines.append(row("   ".join(cells)))
    lines += [
        mid(),
        row(f"{DIM('Skills')}  {h.skills_done}/{h.skills_total}   "
            f"{DIM('Must-know')} {h.core_done}/{h.core_total}   "
            f"{DIM('Boxes')} {h.boxes}   {DIM('Streak')} {h.streak}d"),
        row(f"{DIM('Day')} {h.day}   {DIM('Achievements')} "
            f"{sum(ok for _, ok in h.achievements)}/{len(h.achievements)}"),
        row(),
        bottom(),
    ]
    for ln in lines:
        print(ln)
        sleep(0.03)

    active = [q for q in h.data.get("quests", []) if q["status"] == "active"]
    if active:
        print()
        system_msg(f"You have {GOLD(str(len(active)))} active quest(s). "
                   f"Type {CYAN('./hunter quest')} to view them.")
    print()


def cmd_skills() -> None:
    h = system.compute()
    print()
    for i, p in enumerate(h.data.get("phases", []), 1):
        done = sum(s["status"] == "done" for s in p["skills"])
        total = len(p["skills"])
        state = system.phase_state(p)
        colour = GREEN if state == "done" else GOLD if state == "active" else DIM
        print(colour(BOLD(f" {i}. {p['name']}")) + "  " + CYAN(system.bar(done, total, 12)) + f" {done}/{total}")
        for s in p["skills"]:
            mark = {"done": GREEN("[✓]"), "next": GOLD("[~]"), "later": DIM("[ ]")}[s["status"]]
            star = GOLD(" ★") if s["core"] else ""
            name = s["name"] if s["status"] != "later" else DIM(s["name"])
            print(f"     {mark} {name}{star}")
        print()
    print(DIM("  [✓] done   [~] working on it   [ ] later   ★ must-know"))
    print()


